#!/usr/bin/env bash
# Smoke test: build the CLI, scaffold an agent, and exercise the core flows
# end to end. Run from anywhere; used by CI and useful locally after any
# change. One line per step; details only on failure.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

step() { printf 'ok  %s\n' "$1"; }
die() {
  printf 'FAIL %s\n' "$1" >&2
  [[ -s "$work/out" ]] && sed 's/^/  | /' "$work/out" >&2
  exit 1
}
run() { "$bin" "$@" >"$work/out" 2>&1; }

bin="$work/openroutines"
(cd "$repo" && go build -o "$bin" ./cmd/openroutines)
printf 'smoke: testing %s\n' "$("$bin" version)"

run scaffold "$work/agent" || die "scaffold"
[ "$(readlink "$work/agent/CLAUDE.md")" = "AGENTS.md" ] || die "CLAUDE.md is not a symlink to AGENTS.md"
cd "$work/agent"
printf 'smoke-agent\nSmoke-tests the openroutines CLI\nCI\nci@example.invalid\nUTC\n\nnot-a-real-key\n' \
  | "$bin" configure >"$work/out" 2>&1 || die "configure"
step "scaffold + configure"

run check || die "check on a fresh agent (should pass with warnings)"
step "check passes on a fresh agent"

run routines new smoke-routine || die "routines new"
run check || die "check after routines new"
step "routines new mints a valid inactive routine"

cat > routines/broken.md <<'EOF'
---
schedule: "99 99 * * *"
credentials: [Bad-Name]
skills: [nonexistent]
---
Body
EOF
if run check; then
  die "check passed on a broken routine"
fi
rm routines/broken.md
step "check fails on a broken routine"

# A routine that does not load at all: check must name the file, and the name
# stays claimed -- `routines new` over it would replace the prompt with the
# template.
printf -- '---\nschedule: "0 9 * * *"\nactve: false\n---\nPrecious.\n' > routines/unparseable.md
if run check; then
  die "check passed on an unparseable routine"
fi
grep -q 'routines/unparseable.md' "$work/out" || die "check did not name the unparseable file"
if run routines new unparseable; then
  die "routines new overwrote a routine that does not load"
fi
grep -q Precious routines/unparseable.md || die "routines new clobbered an unparseable routine"
run routines remove unparseable || die "routines remove on an unparseable routine"
[[ ! -e routines/unparseable.md ]] || die "routines remove left the unparseable file"
step "an unparseable routine is named, protected, and removable"

# opencode.json is the harness's config: the permission policy plus custom
# provider endpoint definitions. A provider block is legitimate content --
# check accepts it without a drift warning, flags the id when no model
# string references it (usually a typo on one side), and update must leave
# the whole file byte for byte alone.
cat > opencode.json <<'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "deny"
    },
    "question": "deny"
  },
  "provider": {
    "smoke_gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://gateway.example.invalid/compat" }
    }
  },
  "mcp": {
    "reporter_feed": {
      "type": "remote",
      "url": "https://mcp.example.invalid/feed",
      "headers": { "Authorization": "Bearer {env:REPORTER_TOKEN}" }
    }
  }
}
EOF
run check || die "check with a provider block in opencode.json"
if grep -q 'opencode.json contains' "$work/out"; then
  die "check flagged a provider block as drift"
fi
grep -q 'provider "smoke_gateway" in opencode.json is not referenced' "$work/out" || die "check did not flag the unreferenced provider"
step "check accepts provider config and flags unreferenced ids"

# Plugins install from local paths too (the fixture and development path).
# The synthetic fixtures in testdata/plugins/ cover the feature matrix:
# reporter (reporting routine + skill + raw credential + declared MCP server),
# watcher (routine-only, typed credential + variable + ledger stub), and
# toolkit (skills-only). The grant summary must state what each asks for,
# each stays grouped under .openroutines/plugins/<name>/, ledger stubs wait for the knowledge
# worktree, and a reinstall is refused, not overwritten.
if run plugin add "$repo/testdata/plugins/reporter"; then
  die "non-interactive plugin add should require --yes"
fi
grep -q 'rerun with --yes' "$work/out" || die "non-interactive plugin refusal did not explain --yes"
[[ ! -e .openroutines/plugins/reporter/routines/reporter-digest.md ]] || die "plugin installed without non-interactive consent"
cp opencode.json "$work/opencode.json.pre-plugins"
run plugin add "$repo/testdata/plugins/reporter" --yes || die "plugin add reporter"
grep -q "add to opencode.json's mcp block" "$work/out" || die "declared mcp server not surfaced as a next step"
cmp -s opencode.json "$work/opencode.json.pre-plugins" || die "non-interactive install wrote opencode.json"
for p in toolkit watcher; do
  run plugin add "$repo/testdata/plugins/$p" --yes || die "plugin add $p"
done
grep -q 'trigger: polls' "$work/out" && die "no fixture declares a trigger, summary invented one"
[[ -f .openroutines/plugins/reporter/routines/reporter-digest.md && -d .openroutines/plugins/toolkit/skills/toolkit-notes && -f .openroutines/plugins/watcher/routines/watcher.md ]] || die "plugin files missing"
[[ -f .openroutines/plugins/reporter/.openroutines-source.yaml ]] || die "plugin provenance missing"
grep -q '^active: false$' .openroutines/plugins/reporter/routines/reporter-digest.md || die "installed plugin routine is active"
[[ -e knowledge/ledgers/watcher.md ]] && die "ledger stub installed with no knowledge worktree"
grep -q 'seed knowledge/ledgers/watcher.md' "$work/out" || die "pending stub not surfaced as a next step"
grep -q 'credentials set watcher_app_key' "$work/out" || die "credential next-step missing"
grep -q 'type: github_app' "$work/out" || die "typed-credential openroutines.yml step missing"
if run plugin add "$repo/testdata/plugins/reporter" --yes; then
  die "reinstalling over existing files should be refused"
fi
grep -q 'refusing to replace' "$work/out" || die "collision refusal message missing"
step "plugin add installs all three fixtures, refuses reinstall"

# A local upstream exercises the update contract: provenance supplies the
# merge base, a local schedule edit survives, and an upstream prompt edit
# lands without flattening the plugin.
mkdir -p "$work/update-source/routines"
cat > "$work/update-source/PLUGIN.md" <<'EOF'
---
name: update-demo
description: Smoke-test plugin updates.
---
EOF
cat > "$work/update-source/routines/update-demo.md" <<'EOF'
---
schedule: "0 9 * * *"
timeout: 10m
---
Original prompt.
EOF
git -C "$work/update-source" init -q
git -C "$work/update-source" add .
git -C "$work/update-source" -c user.name=Smoke -c user.email=smoke@example.invalid commit -qm initial
run plugin add "$work/update-source" --yes || die "plugin add update fixture"
sed -i.bak 's/0 9/0 8/' .openroutines/plugins/update-demo/routines/update-demo.md
rm .openroutines/plugins/update-demo/routines/update-demo.md.bak
cat > "$work/update-source/routines/update-demo.md" <<'EOF'
---
schedule: "0 9 * * *"
timeout: 10m
---
Updated upstream prompt.
EOF
git -C "$work/update-source" add .
git -C "$work/update-source" -c user.name=Smoke -c user.email=smoke@example.invalid commit -qm update
run plugin update update-demo --yes || die "plugin update"
grep -q 'schedule: "0 8 ' .openroutines/plugins/update-demo/routines/update-demo.md || die "plugin update lost local schedule edit"
grep -q 'Updated upstream prompt' .openroutines/plugins/update-demo/routines/update-demo.md || die "plugin update missed upstream prompt edit"
run plugin list || die "plugin list"
grep -q 'update-demo' "$work/out" || die "plugin list omitted installed plugin"
step "plugin update merges upstream with local edits and advances provenance"

# The installed routines must satisfy check once their credentials exist and
# the typed entries are declared. The github_app value must be a real PEM:
# check parses it, and piping the multi-line file end to end exercises the
# escaped one-line storage form (#69). A truncated key must refuse, not
# store its first line and report success.
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$work/app-key.pem" 2>/dev/null || die "openssl genpkey"
printf 'fake\n' | run credentials set reporter_token || die "credentials set reporter_token"
run credentials set watcher_app_key < "$work/app-key.pem" || die "credentials set watcher_app_key (piped PEM)"
if head -1 "$work/app-key.pem" | "$bin" credentials set half_key >/dev/null 2>&1; then
  die "credentials set accepted a truncated PEM"
fi
printf 'fake\n' | run credentials set support_desk_secret || die "credentials set support_desk_secret"
cat >> openroutines.yml <<'EOF'
credentials:
  watcher_app_key:
    type: github_app
    app_id: "12345"
  support_desk_secret:
    type: oauth2_client
    token_url: https://auth.example.invalid/oauth2/token
    client_id: "client-abc"
    inject_as: support_desk_token
variables:
  watch_repos: "acme/docs"
EOF
run check || die "check after plugin installs"
step "check passes with the installed plugins wired up"

# The legacy configuration names still load: deployed agents run pinned
# binaries and rename on their own schedule, so every spelling must work.
for legacy in openroutines.yaml agent.yaml; do
  mv openroutines.yml "$legacy"
  run check || die "check with the legacy $legacy name"
  grep -q 'legacy configuration name' "$work/out" || die "check did not nudge the $legacy rename"
  mv "$legacy" openroutines.yml
done
run check || die "check after renaming back"
if grep -q 'legacy configuration name' "$work/out"; then
  die "check nudged the rename on an already-renamed agent"
fi
step "all configuration names load; check nudges the rename"

# update: brings an agent to the running binary's version, rewriting
# framework-owned files (non-interactive stdin applies automatically).
# opencode.json is user config: update must never rewrite it.
cp opencode.json "$work/opencode.json.seeded"
echo "v0.0.0-old" > .openroutines/version
sed -i.bak 's/^ARG OPENROUTINES_VERSION=.*/ARG OPENROUTINES_VERSION=v0.0.0-old/' Dockerfile && rm -f Dockerfile.bak
"$bin" update </dev/null >"$work/out" 2>&1 || die "update"
grep -q "$("$bin" version)" .openroutines/version || die "update did not bump the pin"
grep -q "^ARG OPENROUTINES_VERSION=$("$bin" version)$" Dockerfile || die "update did not rewrite the Dockerfile pin"
cmp -s opencode.json "$work/opencode.json.seeded" || die "update rewrote opencode.json"
step "update bumps the pin, rewrites the Dockerfile pin, leaves opencode.json alone"

# The pin and deploy image are one version invariant. Check rejects drift.
sed -i.bak 's/^ARG OPENROUTINES_VERSION=.*/ARG OPENROUTINES_VERSION=v0.0.0-old/' Dockerfile && rm -f Dockerfile.bak
if run check; then
  die "check accepted a Dockerfile version pin that disagrees with the pin file"
fi
grep -q 'Dockerfile version pin does not match' "$work/out" || die "check did not explain the Dockerfile/pin mismatch"
step "check rejects framework-version drift"

# Per-attempt uid isolation must work inside the production container with
# only the capabilities the template grants: every production gate in the
# runner is keyed on OPENROUTINES_IN_CONTAINER=1, which the host test suite
# never sets, so this is the one place the real staging path runs. The
# supervisor exercises its actual reserved identity; a manual run then
# executes beside the still-live supervisor on the manual identity,
# coordinated through the cross-process knowledge lock. Requires Docker
# (present in CI); skipped only when the binary is missing entirely.
if command -v docker >/dev/null 2>&1; then
  ctx="$work/isolation"
  mkdir -p "$ctx"
  run scaffold "$ctx/agent" || die "scaffold isolation agent"
  cd "$ctx/agent"
  printf 'isolation-agent\nSmoke-tests uid isolation\nCI\nci@example.invalid\nUTC\n\nnot-a-real-key\n' \
    | "$bin" configure >"$work/out" 2>&1 || die "configure isolation agent"
  "$bin" sync >"$work/out" 2>&1 || die "materialize isolation knowledge"
  cat > routines/isolation.md <<'EOF'
---
schedule: "0 9 * * *"
model: fake/model
---
Record the attempt identity.
EOF
  # The manual probe is a distinct routine: the settlement commit becomes
  # visible while the supervised run still holds its routine flock through
  # cleanup, so a same-routine manual run would race that release. A distinct
  # routine cannot collide on the routine lock -- what serializes it against
  # the supervisor is exactly the cross-process knowledge lock under test.
  # Inactive so the live supervisor can never dispatch it itself.
  cat > routines/manual-probe.md <<'EOF'
---
schedule: "0 9 * * *"
active: false
model: fake/model
---
Record the manual attempt identity.
EOF
  mkdir -p knowledge/state
  cat > knowledge/state/isolation.json <<'EOF'
{"routine":"isolation","watermark":"2026-07-31T00:00:00Z","pending":{"run_id":"run_isolation","scheduled_for":"2026-07-31T09:00:00Z","covered_through":"2026-07-31T09:00:00Z","created_at":"2026-07-31T09:00:00Z","attempts":0}}
EOF
  git -C knowledge add state/isolation.json
  git -C knowledge -c user.name=CI -c user.email=ci@example.invalid commit --quiet -m 'Seed isolation smoke run'
  git worktree remove knowledge
  grep -q 'seq 0 32' Dockerfile || die "template Dockerfile does not create the attempt identity pool and manual identity"
  grep -q -- '-G "${groups#,}" agent' Dockerfile || die "template Dockerfile does not put agent in the attempt groups"
  caps="$(sed -n 's/.*setcap \(cap_[a-z_,]*\)=ep.*/\1/p' Dockerfile)"
  [[ -n "$caps" ]] || die "no setcap line in the template Dockerfile"
  cp "$repo/testdata/isolation/Dockerfile" "$ctx/Dockerfile"
  cp "$repo/testdata/isolation/opencode" "$ctx/opencode"
  arch="$(docker version --format '{{.Server.Arch}}')"
  (cd "$repo" && CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -o "$ctx/openroutines" ./cmd/openroutines)
  docker build --quiet --build-arg "CAPS=$caps" -t openroutines-isolation-smoke "$ctx" >"$work/out" 2>&1 || die "isolation image build"
  # Boot the way a minimal container init does: uid and gid set, supplementary
  # groups cleared, /etc/group never consulted. The binary must assert its
  # attempt-group membership itself (cap_setgid); membership granted by
  # useradd -G alone only works under inits that call initgroups, which
  # Docker does and production platforms may not.
  docker run --rm --user root openroutines-isolation-smoke \
    setpriv --reuid agent --regid agent --clear-groups sh -c '
    set -e
    openroutines supervise > /tmp/supervise.out 2>&1 &
    supervisor=$!
    completed=false
    for _ in $(seq 1 300); do
      if git -C /agent show knowledge:ledgers/isolation.md >/dev/null 2>&1; then
        completed=true
        break
      fi
      if ! kill -0 "$supervisor" 2>/dev/null; then
        cat /tmp/supervise.out
        exit 1
      fi
      sleep 0.1
    done
    if [ "$completed" != true ]; then
      echo "supervised isolation run did not complete"
      cat /tmp/supervise.out
      exit 1
    fi
    if ! openroutines routines run manual-probe --write-knowledge > /tmp/manual.out 2>&1; then
      echo "manual run failed beside the supervisor"
      cat /tmp/manual.out
      exit 1
    fi
    kill -TERM "$supervisor"
    wait "$supervisor"
    cat /tmp/supervise.out
    git -C /agent show knowledge:ledgers/isolation.md
    git -C /agent show knowledge:ledgers/escapee.md >/dev/null
    if ls /tmp | grep -q openroutines-; then echo "run workspace not cleaned"; exit 1; fi
    if grep -l "^Uid:.\(20000\|20032\)" /proc/[0-9]*/status 2>/dev/null | grep -q .; then
      echo "escaped descendant outlived the run"; exit 1
    fi
  ' >"$work/out" 2>&1 || die "in-container isolation run"
  grep -q 'uid=20000 gid=20000' "$work/out" || die "model process did not run as the supervised attempt identity"
  grep -q 'uid=20032 gid=20032' "$work/out" || die "manual run did not use the manual attempt identity"
  step "uid isolation works in-container with only the template capabilities"
else
  step "uid isolation in-container test SKIPPED (docker not installed)"
fi

echo "smoke: OK"

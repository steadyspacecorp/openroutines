#!/bin/sh
# Fake opencode for the in-container isolation test. A model run records what
# the sandbox does and does not let it reach; capture calls (`session list`,
# `export`) answer with the clean session record a finished run leaves. The
# follow-up also tries a path outside the sandbox to prove it retains the run's
# boundary.
case "$1" in
session)
  # This path exists for the supervisor but is outside every attempt sandbox.
  echo escaped > /agent/capture-escaped 2>/dev/null || true
  umask 022
  mkdir -p "$HOME/.cache/opencode"
  echo cached > "$HOME/.cache/opencode/state"
  printf '[{"id":"ses_fake"}]\n'
  exit 0
  ;;
export)
  printf '{"messages":[{"info":{"role":"assistant","modelID":"fake","finish":"stop","tokens":{"input":100,"output":20,"reasoning":5,"cache":{"read":0,"write":0}},"cost":0.01}}]}\n'
  exit 0
  ;;
esac

mkdir -p knowledge/ledgers
{
  # Where the sandbox can mount its own procfs the supervisor is not listed
  # at all; where /proc is shared the process list leaks. Either way the thing
  # that matters -- the environment holding the master key -- stays
  # unreadable. Record both.
  echo "visible-commands=$(cat /proc/[0-9]*/comm 2>/dev/null | sort -u | tr '\n' ' ')"
  sup=$(grep -l '^Name:.openroutines' /proc/[0-9]*/status 2>/dev/null | head -1 | sed 's#/proc/##;s#/status##')
  if [ -n "$sup" ]; then
    echo "supervisor-environ=$(head -c 40 /proc/$sup/environ 2>&1 >/dev/null | sed 's/.*: //')"
  else
    echo "supervisor-environ=Permission denied (not even listed)"
  fi
  # The agent repository, the knowledge git worktree, and the supervisor's ssh
  # key are outside what this sandbox grants.
  echo "agent-repo=$(cat /agent/openroutines.yml 2>&1 >/dev/null | sed 's/.*: //')"
  echo "deploy-key=$(cat /home/agent/.ssh/openroutines_deploy 2>&1 >/dev/null | sed 's/.*: //')"
  if error=$(echo x > ./tampered 2>&1); then
    echo "workspace-write=$(cat ./tampered)"
  else
    echo "workspace-write=$(printf '%s' "$error" | sed 's/.*: //')"
  fi
} >> knowledge/ledgers/isolation.md
# A model process can chmod its own files closed. It blocks nothing -- the run
# holds the supervisor's own uid -- but leave a locked tree behind so cleanup
# is exercised against one.
mkdir -p .home/locked
echo hidden > .home/locked/secret
chmod 600 .home/locked/secret
chmod 700 .home/locked
# Escape the run's process group into a new session: where the sandbox has a
# pid namespace this must not outlive the run. The escapee proves it started
# by writing to staged knowledge before sleeping -- the record imports, so the
# smoke test can tell a killed survivor from one that never existed.
setsid sh -c 'echo "escaped pid=$$" > knowledge/ledgers/escapee.md; exec sleep 300' </dev/null >/dev/null 2>&1 &
while [ ! -s knowledge/ledgers/escapee.md ]; do sleep 0.1; done
echo done

#!/bin/sh
# Fake opencode for the in-container isolation test. A model run records the
# identity it runs as into staged knowledge; capture calls (`session list`,
# `export`) answer with the clean session record a finished run leaves --
# and, like the real opencode, install files under HOME with modes that
# deny the group (dirs 0755, files 0644), so the smoke run proves
# capture-home cleanup reclaims and removes what the attempt identity left.
case "$1" in
session)
  umask 022
  mkdir -p "$HOME/.cache/opencode"
  echo cached > "$HOME/.cache/opencode/state"
  printf '[{"id":"ses_fake"}]\n'
  exit 0
  ;;
export)
  printf '{"messages":[{"info":{"role":"assistant","modelID":"fake","finish":"stop","tokens":{"input":100,"output":20,"reasoning":5,"cache":{"read":0,"write":0}},"cost":0.01}}]}\n'
  exit 0
  ;;
esac
mkdir -p knowledge/ledgers
echo "uid=$(id -u) gid=$(id -g)" >> knowledge/ledgers/isolation.md
# The umask keeps default modes group-accessible, but a model process can
# still chmod its own files closed. Leave a locked tree in the attempt home
# so the smoke run proves cleanup reclaims and removes it anyway.
mkdir -p .home/locked
echo hidden > .home/locked/secret
chmod 600 .home/locked/secret
chmod 700 .home/locked
# Escape the run's process group into a new session: cleanup must kill this
# before it removes the workspace, or the survivor could race the removal.
# The escapee proves it started by writing to staged knowledge before sleeping
# -- the record imports, so the smoke test can tell a killed survivor from
# one that never existed.
setsid sh -c 'echo "escaped pid=$$" > knowledge/ledgers/escapee.md; exec sleep 300' </dev/null >/dev/null 2>&1 &
while [ ! -s knowledge/ledgers/escapee.md ]; do sleep 0.1; done
echo done

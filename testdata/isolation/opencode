#!/bin/sh
# Fake opencode for the in-container isolation test: records the identity it
# runs as into staged memory and leaves the session storage a clean run
# leaves (the runner reads it to decide the session ended, and to capture
# token usage).
mkdir -p .home/.local/share/opencode/storage/message/ses_fake
printf '{"role":"assistant","modelID":"fake","finish":"stop","tokens":{"input":100,"output":20,"reasoning":5,"cache":{"read":0,"write":0}},"cost":0.01}' \
  > .home/.local/share/opencode/storage/message/ses_fake/msg_1.json
mkdir -p memory/ledgers
echo "uid=$(id -u) gid=$(id -g)" >> memory/ledgers/isolation.md
# The umask keeps default modes group-accessible, but a model process can
# still chmod its own files closed. Leave a locked tree in the attempt home
# so the smoke run proves cleanup reclaims and removes it anyway.
mkdir -p .home/locked
echo hidden > .home/locked/secret
chmod 600 .home/locked/secret
chmod 700 .home/locked
# Escape the run's process group into a new session: cleanup must kill this
# before it removes the workspace, or the survivor could race the removal.
setsid sleep 300 </dev/null >/dev/null 2>&1 &
echo done
